# ═══════════════════════════════════════════════════════════════
# ASTRA OS / AGENCY OS — Environment Template
# Copy to .env and fill values:  cp .env.example .env
# NEVER commit .env upstream. All keys here are placeholders only.
# ═══════════════════════════════════════════════════════════════

# ─── Core ───
ASTRA_OS_HOME=./
ASTRA_OS_LOG_LEVEL=INFO
AGENCY_OS_LOG_LEVEL=INFO
AGENCY_OS_HOME=./
PYTHONPATH=./

# ─── AI Providers (fill at least one) ───
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENAI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# ─── Search / Research providers (optional) ───
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=

# ─── Data layer ───
DATABASE_URL=postgresql://agency_os:agency_os@localhost:5432/agency_os
# Local dev fallback: sqlite:///data/agency_os.db
REDIS_URL=redis://localhost:6379
CHROMA_URL=http://localhost:8001

# ─── Auth / API ───
JWT_SECRET=change-me-in-production
API_HOST=0.0.0.0
API_PORT=8000

# ─── Studio / local paths (dev only) ───
STUDIO_LOG_LEVEL=INFO
STUDIO_OUTPUT_DIR=./output
STUDIO_TEMP_DIR=./tmp
